+    if (!text || text[0] == '\0') {
+        fprintf(stderr, "参数 %s 缺少数值\n", name);
+        return false;
+    }
+    errno = 0;
+    char* end = NULL;
+    float val = strtof(text, &end);
+    if (errno == ERANGE || end == text || *end != '\0'
+            || val < min || val > max) {
+        fprintf(stderr, "参数 %s 必须是 %.2f~%.2f 的数值: %s\n", name, min, max, text);
+        return false;
+    }
+    *out = val;
+    return true;
+}
